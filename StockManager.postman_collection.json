            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://res.cloudinary.com/dgg6jqds9/image/upload/products/sample.jpg\",\n  \"sort_order\": 1\n}"
            }
          }
        },
        {
          "name": "Delete Product Image",
          "request": {
            "method": "DELETE",
