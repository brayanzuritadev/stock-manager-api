            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laptop Pro\",\n  \"description\": \"High performance laptop\",\n  \"sale_price\": 1299.99,\n  \"purchase_price\": 950.00,\n  \"stock\": 10,\n  \"category_id\": 1\n}"
